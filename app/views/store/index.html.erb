<div class="w-full">
  <ul>
    <% @products.each  do |product| %> 
      <li class="flex mb-6">
        <%= image_tag(product.image, class: 'object-contain w-40 h-48 shadow mr-6') %>
        <div>
          <h2 class="font-bold text-lg mb-3"><%= product.title %></h2>
          <p><%= sanitize(product.description) %></p>
          <div class="mt-3"><%= product.price %></div>
        <div>
      </li>
    <% end %>
  </ul>
</div>
